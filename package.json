{
  "name": "project-ai-music",
  "version": "0.1.0",
  "private": true,
  "description": "AI-music-only listening and publishing platform",
  "workspaces": [
    "apps/*",
    "packages/*",
    "workers/*"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @ai-music/web",
    "build": "npm run build --workspace @ai-music/web",
    "start": "npm run start --workspace @ai-music/web",
    "lint": "npm run lint --workspace @ai-music/web",
    "typecheck": "npm run typecheck --workspace @ai-music/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup:demo": "node scripts/setup-demo.mjs",
    "worker:media": "node workers/media/src/index.mjs",
    "test:db": "bash scripts/test-db.sh",
    "release:preflight": "node scripts/release-env-preflight.mjs",
    "test:release-env": "node --test scripts/release-env-preflight.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
