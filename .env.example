# ---------------------------------------------------------------------------
# Project AI Music — environment template
# Copy to apps/web/.env.local (the app loads env from its own directory).
# ---------------------------------------------------------------------------

# Public site URL (used for canonical URLs, share cards and OAuth callbacks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Demo mode uses the local seeded JSON store (apps/web/.data/demo.json).
# Set to false only when Supabase is configured. See docs/production.md for the
# remaining repository-adapter work required before scaling the web tier.
DEMO_MODE=true

# Secret used to sign demo session cookies (generate: openssl rand -hex 32)
DEMO_AUTH_SECRET=change-me-in-development

# ---------------------------------------------------------------------------
# Supabase (production auth + target database schema). Leave blank for demo mode.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Cloudflare R2 private object storage (production). Optional in demo mode.
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Private buckets: original uploads and processed playback copies.
R2_ORIGINALS_BUCKET=ai-music-originals
R2_STREAMING_BUCKET=ai-music-streaming
# Never expose R2 access keys as NEXT_PUBLIC_* variables.

# ---------------------------------------------------------------------------
# Audio policy (see packages/audio). Thresholds are provisional defaults that
# require product-owner approval before launch.
# ---------------------------------------------------------------------------
AUDIO_MIN_BITRATE_KBPS=256
AUDIO_MAX_DURATION_SECONDS=900
AUDIO_MAX_UPLOAD_BYTES=104857600
AUDIO_TARGET_BITRATE_KBPS=320

# Upload quota for new artist accounts (per UTC day).
UPLOAD_DAILY_LIMIT=5

# Worker shared secret for internal processing endpoints.
MEDIA_WORKER_SECRET=change-me-worker

# ---------------------------------------------------------------------------
# Email delivery (optional; in-app notifications always work). The media worker
# sends opted-in notification emails through a Resend-compatible API.
# ---------------------------------------------------------------------------
EMAIL_API_URL=https://api.resend.com/emails
EMAIL_API_KEY=
EMAIL_FROM=Project AI Music <notifications@example.com>
EMAIL_BATCH=10
